{
  "name": "@seer-pet-anim/anim-export",
  "description": "将捕获的动画帧导出为 GIF / WebP / PNG 序列,含参考缩放、紧裁剪与战斗视口规划",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "author": "Nattsu39",
  "homepage": "https://github.com/Nattsu39/seer-pet-viewer/tree/main/packages/anim-export#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nattsu39/seer-pet-viewer.git",
    "directory": "packages/anim-export"
  },
  "bugs": "https://github.com/Nattsu39/seer-pet-viewer/issues",
  "keywords": [
    "seer",
    "gif",
    "webp",
    "png-sequence",
    "animation-export",
    "canvas"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js"
    },
    "./texture-alignment": {
      "types": "./dist/texture-alignment.d.ts",
      "import": "./dist/texture-alignment.js"
    },
    "./playback": {
      "types": "./dist/playback.d.ts",
      "import": "./dist/playback.js"
    }
  },
  "scripts": {
    "build": "node ../../tools/clean-package-dist.mjs && tsc -p tsconfig.json && node ../../tools/rewrite-worker-urls.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@seer-pet-anim/battle-layout": "workspace:*",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "wasm-webp": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

{
  "name": "@seer-pet-anim/swf-renderer",
  "description": "基于 PixiJS 的赛尔号 SWF 宠物动画播放器",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Nattsu39",
  "homepage": "https://github.com/Nattsu39/seer-pet-viewer/tree/main/packages/swf-renderer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nattsu39/seer-pet-viewer.git",
    "directory": "packages/swf-renderer"
  },
  "bugs": "https://github.com/Nattsu39/seer-pet-viewer/issues",
  "keywords": [
    "seer",
    "pixi",
    "pixijs",
    "swf",
    "renderer",
    "animation"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../tools/clean-package-dist.mjs && tsc -p tsconfig.json && node ../../tools/rewrite-worker-urls.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@seer-pet-anim/anim-export": "workspace:*",
    "@seer-pet-anim/swf-bundle": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "pixi.js": "^8.9.2"
  },
  "peerDependencies": {
    "pixi.js": "^8.9.2"
  }
}

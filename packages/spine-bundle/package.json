{
  "name": "@seer-pet-anim/spine-bundle",
  "description": "解析赛尔号 Unity Spine bundle(spines),提取骨架 JSON、图集与动画序列",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "author": "Nattsu39",
  "homepage": "https://github.com/Nattsu39/seer-pet-viewer/tree/main/packages/spine-bundle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nattsu39/seer-pet-viewer.git",
    "directory": "packages/spine-bundle"
  },
  "bugs": "https://github.com/Nattsu39/seer-pet-viewer/issues",
  "keywords": [
    "seer",
    "unity",
    "asset-bundle",
    "spine",
    "parser"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/buffer-setup.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js"
    }
  },
  "scripts": {
    "build": "node ../../tools/clean-package-dist.mjs && tsc -p tsconfig.json && node ../../tools/rewrite-worker-urls.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arkntools/unity-js": "^5.1.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@esotericsoftware/spine-core": "4.0.31",
    "happy-dom": "^17.4.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

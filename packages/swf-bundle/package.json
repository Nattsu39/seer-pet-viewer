{
  "name": "@seer-pet-anim/swf-bundle",
  "description": "解析赛尔号 Unity SWF 动画 bundle(ppets),提取 clip 数据、网格与图集材质",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Nattsu39",
  "homepage": "https://github.com/Nattsu39/seer-pet-viewer/tree/main/packages/swf-bundle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nattsu39/seer-pet-viewer.git",
    "directory": "packages/swf-bundle"
  },
  "bugs": "https://github.com/Nattsu39/seer-pet-viewer/issues",
  "keywords": [
    "seer",
    "unity",
    "asset-bundle",
    "swf",
    "parser",
    "atlas"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../tools/rewrite-worker-urls.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arkntools/unity-js": "^5.1.0",
    "@arkntools/unity-js-tools": "^3.2.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "happy-dom": "^17.4.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
